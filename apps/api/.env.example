# apps/api environment variables
#
# Copy to `.env` (git-ignored). Loaded by pydantic-settings at startup.
# Convention: our own settings use the MYBAND_ prefix, third-party credentials
# keep their canonical names.

# --- Application -------------------------------------------------------------
MYBAND_ENV=development
MYBAND_LOG_LEVEL=info
# Comma-separated list of allowed browser origins.
MYBAND_CORS_ORIGINS=http://localhost:3000
# Stamped on every analysis job, so a stored result stays interpretable after the
# pipeline changes. Bump it when the worker's output shape changes.
MYBAND_PIPELINE_VERSION=0.1.0
# How long a presigned PUT stays valid. `uploads.expires_at` uses the same clock.
MYBAND_UPLOAD_URL_TTL_SECONDS=3600
# How long a presigned GET stays valid - the MIDI download link. Short on purpose: it
# only has to survive the click that follows the response that carried it, and the URL is
# the only thing authorizing the read.
MYBAND_DOWNLOAD_URL_TTL_SECONDS=300

# --- Database (Supabase PostgreSQL) ------------------------------------------
# Local Supabase (`supabase start`) serves Postgres on 127.0.0.1:54322:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The URL below is the pooled connection of a deployed project.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects that still sign access tokens with the legacy shared secret
# (HS256). A project on asymmetric signing keys - the default, and what the local
# stack issues - is verified against its JWKS instead, and needs no secret.
SUPABASE_JWT_SECRET=

# --- Object storage (Cloudflare R2, S3-compatible) ---------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=myband-audio
# Point the same client somewhere else - Supabase Storage's S3 endpoint for a local
# run (`supabase start` prints its URL and keys), or any S3-compatible service.
# Leave empty for Cloudflare R2.
R2_ENDPOINT_URL=
# Cloudflare R2 accepts "auto"; a local S3 service may insist on its own region.
R2_REGION=auto

# --- GPU workers (RunPod) ----------------------------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# --- Analysis worker (`python -m app.workers`) -------------------------------
# Read by the standalone worker only, never by the API process. Its audio stack
# (librosa, soundfile, pretty_midi) is a separate dependency group:
#   uv sync --project apps/api --group worker
# All of these have working defaults; see docs/analysis-worker.md.
# MYBAND_WORKER_POLL_SECONDS=5
# MYBAND_WORKER_HEARTBEAT_SECONDS=15
# MYBAND_WORKER_MAX_ATTEMPTS=3
# MYBAND_WORKER_RETRY_BACKOFF_SECONDS=2
# MYBAND_WORKER_JOB_TIMEOUT_SECONDS=900
# MYBAND_WORKER_REAP_SECONDS=60
# MYBAND_WORKER_MIDI_WINDOW_SECONDS=30

# --- Operations ---------------------------------------------------------------

# Shared secret for GET /admin/metrics: queue depth by status, the age of the oldest
# queued and in-flight job, and recent activity. It is an operator endpoint, so it
# takes this token rather than a Supabase session:
#   curl -H "Authorization: Bearer $MYBAND_METRICS_TOKEN" localhost:8000/admin/metrics
# Leave it empty and the endpoint is published to a local development run only - it
# answers 404 everywhere else, including staging and production.
MYBAND_METRICS_TOKEN=
