# apps/web environment variables
#
# Copy to `.env.local` (git-ignored) and fill in real values.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC: never put secrets there.

# --- Server-only -------------------------------------------------------------
# Base URL of the FastAPI service, used from Server Components / Route Handlers.
API_BASE_URL=http://127.0.0.1:8000

# --- Public ------------------------------------------------------------------
# Base URL used from the browser (Client Components, fetch hooks).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Supabase (authentication). Both values are public: the publishable key ships to
# the browser and every request is still gated by Row Level Security. Find them in
# the Supabase dashboard under Project Settings -> API.
# A legacy `anon` JWT works in the same variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Dashboard setup the auth flow depends on:
#   1. Authentication -> Providers -> Email (enabled by default; "Confirm email"
#      is what the sign-up flow assumes).
#   2. Authentication -> Providers -> Google: add a client ID/secret, and register
#      https://<project-ref>.supabase.co/auth/v1/callback with Google.
#   3. Authentication -> URL Configuration: Site URL http://localhost:3000 and
#      redirect URLs http://localhost:3000/auth/callback (+ the deployed origin).
# Anything missing here surfaces as `redirect_uri_mismatch` or a redirect back to
# /login with an error message.
